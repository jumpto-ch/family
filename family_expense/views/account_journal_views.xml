<odoo>
    <record id="account_journal_dashboard_quick_expense_kanban_view" model="ir.ui.view">
        <field name="name">account.journal.dashboard.quick.expense.kanban</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@id='account.JournalBodySalePurchase']/div[1]/t[2]/a" position="before">
                <button type="object" name="action_create_new_entry" class="btn btn-primary oe_kanban_action_button"
                        journal_type="purchase" groups="account.group_account_invoice">
                    <span>Quick expense</span>
                </button>
            </xpath>

            <!-- Remove the existing "New Transaction" button -->
            <xpath expr='//t[@t-if="journal_type == &#39;cash&#39;"]//button[@name="action_new_transaction"]' position="replace"> 
            </xpath>
            <xpath expr='//t[@t-if="journal_type == &#39;cash&#39;"]//a[@name="action_new_transaction"]' position="replace">
            </xpath>

            <xpath expr="//div[@id='dashboard_bank_cash_left']" position="inside">
                <t t-if="journal_type == 'cash' and dashboard.make_quick_transaction">
                    <div class="d-flex flex-wrap gap-2">
                        <button name="action_cash_in_out" type="object" class="btn btn-primary oe_kanban_action_button"
                                groups="account.group_account_invoice">
                            <cashspan>Cash in/out</cashspan>
                        </button>
                    </div>
                </t>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">account.journal.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='advanced_settings']/group" position="inside">
                <group string="Quick expense" modifiers="{'invisible': [('type', 'not in', ('bank','cash'))]}">
                    <field name="make_quick_payment"/>
                </group>
                <group string="Quick transaction" modifiers="{'invisible': [('type', 'not in', ('bank','cash'))]}">
                    <field name="make_quick_transaction"/>
                    <field name="quick_transaction_account_domain"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>