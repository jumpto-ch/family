<odoo>
    <record id="account_move_quick_expense_wizard_form_view" model="ir.ui.view">
        <field name="name">account.move.quick.expense.create.wizard.form</field>
        <field name="model">account.move.quick.expense</field>
        <field name="arch" type="xml">
            <form string="Account Entry">
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="account_id" options="{'no_create': True}"/>
                        <field name="price"/>
                        <field name="description"/>
                        <field name="invoice_date" widget="date"/>
                        <field name="is_draft"/>
                        <field name="payment_method"/>
                    </group>
                    <footer>
                        <button name="action_create_expense" string="Create" type="object" class="btn-primary" context="{'direction': 'in'}"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_account_move_quick_expense_wizard" model="ir.actions.act_window">
        <field name="name">Quick Expense Wizard</field>
        <field name="res_model">account.move.quick.expense</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account_move_quick_expense_wizard_form_view"/>
        <field name="target">new</field>
    </record>
</odoo>